{
  "name": "@upstash/model-multiplexer",
  "version": "0.3",
  "description": "A multiplexer for Large Language Model APIs built on the OpenAI SDK. It combines quotas from multiple models and automatically uses fallback models when the primary models are rate limited.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "example": "node -r dotenv/config -r ts-node/register examples/basic-usage.ts",
    "test:models": "node -r dotenv/config -r ts-node/register src/MultiplexerTester.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "openai",
    "multiplexer",
    "llm",
    "rate-limit",
    "api",
    "upstash"
  ],
  "author": "Upstash",
  "license": "MIT",
  "peerDependencies": {
    "openai": "^4.104.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/upstash/model-multiplexer.git"
  }
}
